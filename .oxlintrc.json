{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off",
    "style": "off"
  },
  "rules": {
    // --- Type safety -------------------------------------------------------
    // The repo bans `any`, non-null assertions, and unsafe casts. These rules
    // are what make that a build failure rather than a review preference.
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",

    // These two are the reason type-aware linting is worth its setup cost: an
    // unawaited promise in a request handler is silent data loss, and no
    // syntax-only linter can see it.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    // `@deprecated` is only a strikethrough in the editor unless CI fails on it.
    "typescript/no-deprecated": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",

    // --- Correctness -------------------------------------------------------
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "no-param-reassign": "error",
    "promise/no-return-wrap": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "error",
    // A stylesheet has nothing to bind, so importing it for its side effect is
    // the only way to import it.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    // --- Noise -------------------------------------------------------------
    // `console.log` is debugging left behind. `warn` and `error` are how a
    // server process reports a problem when there is no logger to inject.
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "no-alert": "error",

    // --- Conventions -------------------------------------------------------
    // Files and directories are kebab-case; types and components are
    // PascalCase inside them.
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],

    // --- Deliberately off --------------------------------------------------
    // `null` is a real value in JSON payloads and SQL columns; pretending
    // otherwise means translating at every boundary.
    "unicorn/no-null": "off"
  },
  "overrides": [
    {
      // Tests read back JSON the CLI wrote and assert on it directly, and
      // node:test's test() returns a promise nothing needs to await.
      "files": ["test/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-floating-promises": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      // Scripts report to the terminal they run in.
      "files": ["scripts/**"],
      "rules": { "no-console": "off" }
    }
  ],
  "options": {
    // Type-aware linting via oxlint-tsgolint, which is built on typescript-go.
    "typeAware": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "local-backup/**"]
}
